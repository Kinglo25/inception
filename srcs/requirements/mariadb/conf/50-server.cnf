# MariaDB server configuration

[mysqld]
# Unix socket location for local connections
socket  = /run/mysqld/mysqld.sock

# Directory where database files are stored
datadir = /var/lib/mysql

# Listen on all network interfaces (0.0.0.0)
# This allows connections from other containers
bind_address=0.0.0.0

# Standard MySQL/MariaDB port
port = 3306

# Run the server as the mysql user for security
user = mysql
